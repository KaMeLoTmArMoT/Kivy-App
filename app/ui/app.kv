<MDLabelBtn>
    text_size: self.width, None
    height: self.texture_size[1]
    padding: 10, 10
    size_hint_y: None
    halign: "center"
    font_size: 32

<AppScreenCard@MDBoxLayout>:
    orientation: 'vertical'
    padding: [12, 8, 12, 8]
    spacing: 8

<AppHeaderButton@Button>:
    size_hint_y: None
    height: 32
    font_size: 16
    background_normal: ''
    background_color: (0.18, 0.22, 0.26, 0.85)
    color: (0.9, 0.9, 0.9, 1)

<AppActionButton@Button>:
    size_hint_y: None
    height: 36
    font_size: 15
    background_normal: ''
    background_color: (0.22, 0.28, 0.35, 0.9)
    color: (0.95, 0.95, 0.95, 1)

<Header>:
    MDBoxLayout:
        orientation: 'horizontal'
        spacing: 6
        padding: [6, 2, 6, 2]
        size_hint_y: None
        height: 36

        AppHeaderButton:
            id: main
            text: "Main Screen"
            on_press: root.navigate_to("main")

        AppHeaderButton:
            id: imageview
            text: "Image Screen"
            on_press: root.navigate_to("imageview")

        AppHeaderButton:
            id: dbview
            text: "DB Screen"
            on_press: root.navigate_to("dbview")

        AppHeaderButton:
            id: mlview
            text: "ML Screen"
            on_press: root.navigate_to("mlview")

        AppHeaderButton:
            id: detectionview
            text: "Detection"
            on_press: root.navigate_to("detectionview")

        ImageMDButton:
            id: settingsview
            source: 'app/resources/icons/settings.png'
            size_hint_x: None
            width: dp(32)
            height: dp(32)
            pos_hint: {"center_y": 0.5}

            on_press: root.navigate_to("settingsview")

            fit_mode: "contain"
            allow_hover: True

            canvas.before:
                Color:
                    rgba: 1, 1, 1, .15
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [8, 8, 8, 8]

<SelectableImage>:
    ImageMDButton:
        id: img
        source: root.source
        fit_mode: "contain"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        line_color: (1, 1, 1, 0.6) if root.selected else root.line_color
        md_bg_color: (1, 1, 1, 0.1) if root.selected else (0, 0, 0, 0)
    MDCheckbox:
        id: checkbox
        active: root.selected
        size_hint: None, None
        size: "48dp", "48dp"
        pos_hint: {"center_x": 0.96, "center_y": 0.96}
