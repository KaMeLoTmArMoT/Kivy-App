<DetectionScreen>
    MDBoxLayout:
        orientation:'vertical'

        Header:
            id: header
            size_hint: 1, None
            height: 36

        MDBoxLayout:
            size_hint: 1, 0.01

        AppScreenCard:
            size_hint: 0.99, 0.96
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            orientation: 'vertical'
            padding: 8
            spacing: 6

            MDBoxLayout:
                orientation: 'horizontal'
                spacing: 8

                MDBoxLayout:    # left sidebar
                    orientation: 'vertical'
                    size_hint_x: 0.22
                    spacing: 4

                    MDLabelBtn:
                        id: project_label
                        font_size: 15
                        text: "Select Project"
                        size_hint_y: None
                        height: 32
                        padding: 0, 0
                        allow_hover: True
                        halign: "center"
                        valign: "center"
                        on_press: root.select_project_button()

                    MDBoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: 32
                        spacing: 4

                        AppActionButton:
                            text: "⬅"
                            size_hint_x: 0.3
                            on_press: root.update_value(-1)

                        MDLabel:
                            id: label_spinner
                            text: "11"
                            halign: "center"
                            valign: "middle"
                            size_hint_x: 0.4
                            font_size: 16

                        AppActionButton:
                            text: "+"
                            size_hint_x: 0.3
                            on_press: root.update_value(1)

                    ScrollView:
                        size_hint_y: 0.45
                        do_scroll_x: False
                        do_scroll_y: True
                        scroll_wheel_distance: 60

                        GridLayout:
                            id: model_grid
                            cols: 1
                            size: self.parent.size
                            pos: self.parent.pos
                            size_hint: None, None
                            height: self.minimum_height
                            row_default_height: 24

                    AppActionButton:
                        font_size: 13
                        text: "Open LabelImg"
                        on_press: root.labelimg_open()

                    AppActionButton:
                        font_size: 13
                        text: "Close LabelImg"
                        on_press: root.labelimg_close()

                    AppActionButton:
                        font_size: 13
                        text: "Split Dataset"
                        on_press: root.split()

                    AppActionButton:
                        font_size: 13
                        text: "Train YOLO"
                        on_press: root.train()

                MDBoxLayout:    # image preview window
                    orientation: 'vertical'
                    id: preview
                    size_hint_x: 0.56

                    Image:
                        id: image
                        size_hint: 1, 0.75
                        fit_mode: "contain"
                        pos_hint: {'center_x': 0.5, 'center_y': 0.5}

                    MDBoxLayout:  # start/stop video preview
                        size_hint_y: None
                        height: 40
                        orientation: 'horizontal'
                        spacing: 12
                        padding: [8, 4]

                        AppActionButton:
                            text: 'Start Video'
                            size_hint_x: 0.5
                            on_release: root.display_start()

                        AppActionButton:
                            text: 'Stop Video'
                            size_hint_x: 0.5
                            on_release: root.display_stop()

                MDBoxLayout:    # right sidebar
                    orientation: 'vertical'
                    size_hint_x: 0.22
                    spacing: 4

                    AppActionButton:
                        font_size: 13
                        text: "YOLO Load"
                        on_press: root.yolo_load()

                    MDBoxLayout:  # slider and confidence box
                        size_hint_y: None
                        height: 60
                        orientation: 'vertical'
                        padding: [4, 2]

                        MDLabel:
                            size_hint_y: None
                            height: 20
                            text: "Confidence: " + str(round(slider.value, 2))
                            font_size: 13
                            halign: "center"

                        SafeMDSlider:
                            id: slider
                            min: 0.05
                            value: 0.5
                            max: 1
                            step: 0.05
                            size_hint_y: None
                            height: 36
                            hint: False
                            orientation: 'horizontal'
                            on_touch_up: if self.collide_point(*args[1].pos): root.update_confidence()

                    AppActionButton:
                        font_size: 13
                        text: "YOLO Terminate"
                        on_press: root.yolo_terminate()

                    AppActionButton:
                        font_size: 13
                        text: "YOLO Optimize"
                        on_press: root.yolo_optimize()

                    AppActionButton:
                        font_size: 13
                        text: "TensorBoard"
                        on_press: root.launch_tensorboard()

                    Widget:
                        size_hint_y: 0.3

        MDBoxLayout:
            size_hint: 1, 0.01
